#version 450

layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) buffer RayBuffer { float data[]; };
layout(push_constant) uniform Batch { uint count; };

float slab(uint start)
{
    float low = 0.0, high = 3.402823466e38;
    for (uint axis = 0; axis < 3; ++axis) {
        float origin = data[start + axis];
        float direction = data[start + 3 + axis];
        float a = data[start + 6 + axis] - origin;
        float b = data[start + 9 + axis] - origin;
        if (abs(direction) < 1.0e-12) {
            if (a > 0.0 || b < 0.0) return -1.0;
            continue;
        }
        a /= direction;
        b /= direction;
        low = max(low, min(a, b));
        high = min(high, max(a, b));
        if (low > high) return -1.0;
    }
    return low;
}

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i < count) data[count * 12 + i] = slab(i * 12);
}
